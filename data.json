 "rules": [
  {
   "rule": "What gets voted",
   "text": "Each week, Seats vote how the fund's book is split across a fixed list of tokens. Gains are measured in ETH; WETH is the cash sleeve."
  },
  {
   "rule": "Max per token",
   "text": "No more than 25% of the book in any one token. WETH has no cap."
  },
  {
   "rule": "$TMF is held",
   "text": "The fund never sells its own $TMF. Only the rest of the book is split."
  },
  {
   "rule": "50% backing",
   "text": "A token gets nothing that week unless cards holding at least half the weight cast give it something. Otherwise its share stays in WETH."
  },
  {
   "rule": "Turnout floor",
   "text": "The dials only change if at least 25 different Seats vote. Otherwise last week's settings stay."
  },
  {
   "rule": "Dials",
   "text": "Profit take: 0–50% of the week's confirmed gain paid out in kind. Expense ratio: 0–20% of the fund's fee income burned."
  },
  {
   "rule": "How fast it moves",
   "text": "Each Friday the fund moves at most a fifth of the book toward the voted split, and only as much as each pool can take while moving its price about half a percent."
  },
  {
   "rule": "Gains must last",
   "text": "Dividends are paid on the lower of two readings at least six days apart, using 30-minute average prices."
  },
  {
   "rule": "Who votes",
   "text": "Only Seats enrolled before the week began. One card per Seat per week; once counted it can't be changed."
  },
  {
   "rule": "The bell",
   "text": "Voting closes Friday 20:00 UTC: 3pm New York in winter, 4pm in summer. The chain's clock ignores daylight saving."
  }
 ],
 "glossary": [
  {
   "term": "WETH",
   "def": "ETH in token form. The fund's cash sleeve: holding it means no gain and no loss against ETH."
  },
  {
   "term": "USDG",
   "def": "Global Dollar, a dollar stablecoin issued by Paxos."
  },
  {
   "term": "$TMF (held)",
   "def": "The fund's own token. The fund never sells it, and it isn't part of the split."
  },
  {
   "term": "Seat / chair",
   "def": "One vote in a fund. Each Seat casts one card per week."
  },
  {
   "term": "Card",
   "def": "A Seat's vote: a % for each token plus the two dials."
  },
  {
   "term": "Profit take",
   "def": "The share of a week's confirmed gain paid out as dividends, in kind (0–50%)."
  },
  {
   "term": "Expense ratio",
   "def": "The share of the fund's fee income that gets burned (0–20%)."
  },
  {
   "term": "Backing",
   "def": "A token only gets money if cards holding at least half the vote weight give it something."
  },
